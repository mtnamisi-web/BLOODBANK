  "$schema": "openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public && cp -r bloodbank/src/main/resources/static/. public/",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mandate-italia-headed-dynamic.trycloudflare.com/api/:path*" }
  ]
}
