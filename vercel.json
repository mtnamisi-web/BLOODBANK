{
  "$schema": "openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public && cp -r bloodbank/src/main/resources/static/. public/",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tall-asthma-galleries-alpha.trycloudflare.com/api/:path*" },
    { "source": "/ws", "destination": "https://tall-asthma-galleries-alpha.trycloudflare.com/ws" }
  ]
}
